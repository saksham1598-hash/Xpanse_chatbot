  <data key="d3">chunk-17500047ad0180b576e941b2b6f9e69b</data>
  <data key="d2">When servicing is transferred, the borrower must receive updated statements regarding their escrow account to ensure smooth management of funds.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
</node>
<node id="Flood Disaster Protection Act of 1973">
  <data key="d0">Flood Disaster Protection Act of 1973</data>
  <data key="d1">economic_policy</data>
  <data key="d2">The Flood Disaster Protection Act of 1973 is a U.S. law that sets requirements regarding flood insurance for properties located in flood-prone areas.&lt;SEP&gt;The Flood Disaster Protection Act requires borrowers to maintain hazard insurance in areas prone to flooding and affects loan servicers' actions regarding insurance.</data>
  <data key="d3">chunk-08b7ae1492b3de4d1e4389da5a03ea08&lt;SEP&gt;chunk-4523fa52055965ffd8fb7c7a1badd8bf</data>
  <data key="d4">unknown_source</data>
</node>
<node id="Mortgage Loan Contract">
  <data key="d0">Mortgage Loan Contract</data>
  <data key="d1">category</data>
  <data key="d2">A mortgage loan contract is an agreement between a borrower and lender that outlines the terms of the loan and requirements for maintaining insurance.&lt;SEP&gt;The mortgage loan contract outlines the terms and conditions agreed upon by the lender and the borrower regarding the loan.</data>
  <data key="d3">chunk-a7a5f1a5e29a35b6e3bade16181f31a5&lt;SEP&gt;chunk-4523fa52055965ffd8fb7c7a1badd8bf</data>
  <data key="d4">unknown_source</data>
</node>
